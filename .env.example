# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# MapTiler API Key (used for 3D terrain elevation and satellite basemap)
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Project GAKIT Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Keepalive ping flag (optional, '1' to enable background keepalive pings)
NEXT_PUBLIC_KEEPALIVE=0
